{
  "manifest_version": 3,
  "name": "Hover Preview",
  "version": "1.0.0",
  "description": "Peek at links without leaving your page. Adjustable previews, hover delay, and a clean, distraction-free interface.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Hover Preview",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
